# Shared local Postgres container managed by ../ensure-db.sh (datendrehscheibe-dev).
# Payload uses its own schema inside the shared "datendrehscheibe" database so it
# never collides with Datendrehscheibe's own tables.
DATABASE_URL=postgres://saplus_dev:saplus_dev@localhost:5432/datendrehscheibe
DATABASE_SCHEMA=payload

PAYLOAD_SECRET=YOUR_SECRET_HERE

# Only needed once the Website's revalidation webhook exists.
# FRONTEND_URL=http://localhost:3001
# REVALIDATE_SECRET=YOUR_SECRET_HERE
