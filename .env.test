# Used only by `pnpm test:int` / `pnpm test:coverage` (see vitest.setup.ts). Same shared
# local Postgres container as `.env`, but a dedicated DATABASE — not just a different
# schema: Payload/Drizzle bakes the schema name into each generated migration's raw SQL,
# so pointing at the same database with only DATABASE_SCHEMA changed still collides with
# dev's own "payload" schema. A separate database gives real isolation regardless.
DATABASE_URL=postgres://saplus_dev:saplus_dev@localhost:5432/datendrehscheibe_test
DATABASE_SCHEMA=payload

PAYLOAD_SECRET=test-secret-do-not-use-in-production

FRONTEND_URL=http://localhost:3001
